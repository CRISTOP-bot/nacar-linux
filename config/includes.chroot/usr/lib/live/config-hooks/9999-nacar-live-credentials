#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Generate a per-boot Live password; never put it in argv, files, or logs.
set -eu

LIVE_USER=live
LIVE_CONSOLE=/dev/console

fail() {
    printf 'Nacar Live credential hook: %s\n' "$1" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'must run as root'
getent passwd "$LIVE_USER" >/dev/null 2>&1 || fail 'live account does not exist yet'
command -v chpasswd >/dev/null 2>&1 || fail 'chpasswd is unavailable'
command -v base32 >/dev/null 2>&1 || fail 'base32 is unavailable'
[ -c "$LIVE_CONSOLE" ] && [ -w "$LIVE_CONSOLE" ] || fail 'local console is unavailable'

# Open the target before changing the account so an absent console cannot
# leave the user with a password that was never shown.
if ! exec 3>"$LIVE_CONSOLE"; then
    fail 'cannot open the local console'
fi

OLD_SHADOW="$(getent shadow "$LIVE_USER")" || fail 'cannot read the prior account state'
case "$OLD_SHADOW" in
    "$LIVE_USER":*) OLD_HASH=${OLD_SHADOW#*:}; OLD_HASH=${OLD_HASH%%:*} ;;
    *) fail 'shadow entry does not match the live account' ;;
esac

# Ten random bytes encode to sixteen RFC 4648 Base32 characters (80 bits).
PASSWORD="$(dd if=/dev/urandom bs=10 count=1 2>/dev/null | base32 | tr -d '\n=')"
[ "${#PASSWORD}" -eq 16 ] || fail 'random password generation failed'
case "$PASSWORD" in
    *[!A-Z2-7]*) fail 'random password contains an unexpected character' ;;
esac

restore_old_hash() {
    printf '%s:%s\n' "$LIVE_USER" "$OLD_HASH" | chpasswd --encrypted
}

if ! printf '%s:%s\n' "$LIVE_USER" "$PASSWORD" | chpasswd; then
    restore_old_hash || printf 'Nacar Live credential hook: prior account state could not be restored\n' >&2
    unset PASSWORD OLD_SHADOW OLD_HASH
    fail 'could not set the temporary password'
fi

if ! printf '\nNácar GNU/Linux Live password for %s: %s\n\n' "$LIVE_USER" "$PASSWORD" >&3; then
    restore_old_hash || printf 'Nacar Live credential hook: prior account state could not be restored\n' >&2
    unset PASSWORD OLD_SHADOW OLD_HASH
    fail 'could not display the temporary password; previous account state restored if possible'
fi

unset PASSWORD OLD_SHADOW OLD_HASH
exit 0
